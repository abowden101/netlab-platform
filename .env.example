# Copy to .env and fill in real values. Never commit a filled-in .env.
DATABASE_URL=postgresql+psycopg2://netlab:netlab-dev-only@localhost:5432/netlab
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Lab sessions
LAB_TTL_SECONDS=7200
LAB_IDLE_TIMEOUT_SECONDS=1800
MAX_LABS_PER_HOST=8
MAX_CPU_PER_LAB=8.0
MAX_MEM_PER_LAB_MB=8192

# Containerlab / Docker
CONTAINERLAB_BIN=containerlab
UPLOAD_DIR=./uploads
MAX_IMAGE_UPLOAD_MB=4096

# Frontend
VITE_API_URL=http://localhost:8000
